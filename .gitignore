# Dependencies
node_modules/
.pnpm-store/
vendor/

# Build output
dist/
build/
out/
.next/
*.exe
*.dll
*.so
*.dylib
backend/bin/

# Test and coverage
coverage/
*.out
*.test
.nyc_output/

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
gha-creds-*.json

# Local data — never commit patient data, synthetic or otherwise
*.sqlite
*.sqlite3
*.db
/data/
/tmp/
/scratch/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Local environment
.env
.air/

# Python
__pycache__/
*.py[cod]

# Metro's bundle-check output. `pnpm --filter @dthcms/mobile run bundle:check` compiles
# the Android bundle to prove every import resolves, and leaves 4.4MB of Hermes bytecode
# behind. The compile is the point; the output is disposable.
mobile/.expo-export/
.expo/

# Generated API documentation. Built from api/openapi.yaml by `pnpm run spec:docs` and by
# CI, which uploads it as an artifact. A 1.3MB self-contained page regenerated on every
# spec change does not belong in history; the contract it is built from does.
api/docs.html

# Tooling caches
.turbo/
.eslintcache
*.tsbuildinfo
.gocache/

# Generated synthetic populations. Reproducible from a seed and a profile — `make synth`,
# `make synth-review` — so the recipe belongs in history and the output does not. A cohort
# file is also the one thing in this repository that would look like patient data to
# someone who found it out of context, which is a second reason not to commit one.
cohort*.ndjson
synthetic-review*.html

# The transfer folder. Bundles handed between this working copy and a session that has no
# access to it — a source tarball and the notes for applying it. Delivery scaffolding, not
# the project: committing a five-megabyte snapshot of the tree *into* the tree is a way to
# double the repository every time one is handed over.
_sync/

# Screenshot and delivery scaffolding, alongside _sync/ above. These are folders a session
# with no access to this working copy writes files into so they can be handed over — UI
# screenshots for review, gallery exports, drafts on their way to docs/. They are how the
# work arrives, not the work.
#
# Added after a `git add --all` swept seventeen images and a duplicate of
# docs/prescription-editor.md into a commit whose message was about something else. The
# images are in history now and are staying there; this stops the next batch.
#
# A screenshot is also the one artefact in this repository that could carry a real patient
# name without anyone noticing — every one of these is taken against seeded data, and the
# way to keep that true is for them not to be committable by accident.
_gallery/
shots-*/
Claude outputs/
