      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Detection rate (criterion 1)",
      "description": "The frozen set's injected hallucinations, and how many the current validator caught. **1.0 or the build does not ship**: this is not a clinical threshold requiring anybody's approval, it is a check that failed to catch a fabricated number somebody deliberately put in front of it.",
