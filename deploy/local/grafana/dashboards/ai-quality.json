    {
      "type": "timeseries",
      "title": "Answers, by outcome",
      "description": "Every AI call, by what became of it. UNGROUNDED sits beside INVALID_OUTPUT here deliberately: one is a model that returned malformed JSON and was retried, the other is a model that invented a value and was not. A rise in the first is a transport or prompt-shape problem; a rise in the second is a quality problem, and the two call for different work.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dthcms-prometheus"
