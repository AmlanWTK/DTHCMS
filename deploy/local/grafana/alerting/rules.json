          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "datasource": {
            "type": "prometheus",
            "uid": "dthcms-prometheus"
          }
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
