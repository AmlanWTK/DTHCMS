      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [300]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["B"]
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      }
    ],
    "labels": {
      "severity": "critical",
      "service": "dthcms-worker"
    },
    "annotations": {
      "summary": "A job type has work that has been due for more than five minutes.",
      "description": "Age rather than depth, because a queue of four hundred that is draining is healthy and a queue of two that has not moved in an hour is not. The metric excludes jobs sitting out a retry backoff \u2014 those are waiting on purpose \u2014 so this firing means work is due and no worker has taken it. Five minutes is the smallest interval that is not noise: a rolling worker deploy takes about ninety seconds, and an alert that fires on every deploy is one people learn to ignore.",
      "runbook": "Check that a worker is running and that its queues include the kind named in the alert (DTHCMS_WORKER_QUEUES). Then check whether the kind is paused: a paused queue and a stopped worker look identical from the outside, and dthcms_job_kind_paused separates them. If workers are up and the kind is not paused, look at the dead-letter list \u2014 a handler that panics on every claim empties nothing and refills constantly."
    }
  },
