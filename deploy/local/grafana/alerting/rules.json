[
  {
    "uid": "dthcms-error-rate",
    "title": "API 5xx rate above 5%",
    "ruleGroup": "dthcms",
    "folderUID": "dthcms",
    "orgID": 1,
    "condition": "C",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": false,
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "dthcms-prometheus",
        "model": {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count[5m])), 0.001)",
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "datasource": {
            "type": "prometheus",
            "uid": "dthcms-prometheus"
          }
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [0.05]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["B"]
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      }
    ],
    "labels": {
      "severity": "critical",
      "service": "dthcms-api"
    },
    "annotations": {
      "summary": "More than one request in twenty is failing.",
      "description": "5xx means the system is at fault, not the caller. Five minutes rather than instantly, because a deploy or a brief database blip can produce a spike that resolves itself, and an alert that fires on those is one people learn to ignore. clamp_min keeps a single failed request on an idle night from reading as 100%.",
      "runbook": "Open the Errors dashboard and find which endpoint. One endpoint means a bug in it; all endpoints means a dependency \u2014 check /readyz, then the Saturation dashboard for the database pool."
    }
  },
  {
    "uid": "dthcms-latency",
    "title": "p95 latency above 2 seconds",
    "ruleGroup": "dthcms",
    "folderUID": "dthcms",
