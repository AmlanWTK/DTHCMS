  {
    "uid": "dthcms-projection-lag",
    "title": "A read model is more than a minute behind",
    "ruleGroup": "dthcms",
    "folderUID": "dthcms",
    "orgID": 1,
    "condition": "C",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": false,
