          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "datasource": {
            "type": "prometheus",
            "uid": "dthcms-prometheus"
          }
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [0.8]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["B"]
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      }
    ],
    "labels": {
      "severity": "warning",
      "service": "dthcms-api"
    },
    "annotations": {
      "summary": "Most database connections are checked out.",
      "description": "This is the leading indicator for a whole class of incident: once the pool is full, every request queues for a connection and the entire API appears slow at once, with no single slow query to blame. Catching it at 80% leaves room to act before that happens.",
      "runbook": "Saturation dashboard for the trend. A sudden jump is usually a slow query holding connections — find it in traces. A slow climb is usually a leak: a code path acquiring a connection and not releasing it."
    }
  },
