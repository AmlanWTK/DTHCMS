    ],
    "labels": {
      "severity": "critical",
      "service": "dthcms-projector"
    },
    "annotations": {
      "summary": "A read model that commits with its event is behind, which should be impossible.",
      "description": "A synchronous projection is written inside the append transaction: the event and the row commit together or neither does. Any lag at all means an event was appended without its projection running — the wiring is wrong, or somebody appended through a path that does not carry the synchronous set. Clinicians are reading values that are not the latest, which is the failure this projection exists to prevent.",
      "runbook": "Check that the API assembles its event store through clinicalStore() with projection.NewSyncSet. Then `make project-rebuild REASON=... NAME=visit_vital` to make the model correct again, and fix the write path before the next clinic."
    }
  },
  {
    "uid": "dthcms-job-queue-stalled",
    "title": "Background work is due and nobody is doing it",
    "ruleGroup": "dthcms",
    "folderUID": "dthcms",
    "orgID": 1,
    "condition": "C",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": false,
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "dthcms-prometheus",
        "model": {
          "refId": "A",
          "expr": "max by (kind) (dthcms_job_queue_oldest_due_seconds)",
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "datasource": {
            "type": "prometheus",
            "uid": "dthcms-prometheus"
          }
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [300]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["B"]
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      }
    ],
    "labels": {
      "severity": "critical",
      "service": "dthcms-worker"
    },
    "annotations": {
      "summary": "A job type has work that has been due for more than five minutes.",
      "description": "Age rather than depth, because a queue of four hundred that is draining is healthy and a queue of two that has not moved in an hour is not. The metric excludes jobs sitting out a retry backoff — those are waiting on purpose — so this firing means work is due and no worker has taken it. Five minutes is the smallest interval that is not noise: a rolling worker deploy takes about ninety seconds, and an alert that fires on every deploy is one people learn to ignore.",
      "runbook": "Check that a worker is running and that its queues include the kind named in the alert (DTHCMS_WORKER_QUEUES). Then check whether the kind is paused: a paused queue and a stopped worker look identical from the outside, and dthcms_job_kind_paused separates them. If workers are up and the kind is not paused, look at the dead-letter list — a handler that panics on every claim empties nothing and refills constantly."
    }
  },
  {
