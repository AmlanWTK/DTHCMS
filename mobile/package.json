{
  "name": "@dthcms/mobile",
  "private": true,
  "version": "0.1.0",
  "description": "DTHCMS station application — the 12 clinical stations (built from CP11)",
  "main": "expo-router/entry",
  "scripts": {
    "tokens": "pnpm --filter @dthcms/design-tokens build",
    "start": "pnpm run tokens && expo start",
    "android": "pnpm run tokens && expo run:android",
    "bundle:check": "pnpm run tokens && expo export --platform android --output-dir .expo-export",
    "test": "pnpm run tokens && vitest run",
    "typecheck": "pnpm run tokens && tsc --noEmit",
    "test:coverage": "pnpm run tokens && vitest run --coverage"
  },
  "dependencies": {
    "@dthcms/api-client": "workspace:*",
    "@dthcms/design-tokens": "workspace:*",
    "@dthcms/shared-schemas": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.102.0",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17",
    "use-intl": "^4.13.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@dthcms/test-config": "workspace:*",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
