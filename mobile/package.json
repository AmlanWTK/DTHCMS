{
  "name": "@dthcms/mobile",
  "private": true,
  "version": "0.1.0",
  "description": "DTHCMS station application — the 12 clinical stations (built from CP11)",
  "main": "expo-router/entry",
  "scripts": {
    "tokens": "pnpm --filter @dthcms/design-tokens build",
    "start": "pnpm run tokens && expo start",
    "android": "pnpm run tokens && expo run:android",
    "bundle:check": "pnpm run tokens && expo export --platform android --output-dir .expo-export",
    "test": "pnpm run tokens && vitest run",
    "typecheck": "pnpm run tokens && tsc --noEmit",
    "test:coverage": "pnpm run tokens && vitest run --coverage"
  },
  "dependencies": {
    "@dthcms/api-client": "workspace:*",
    "@dthcms/clinical-calc": "workspace:*",
    "@dthcms/design-tokens": "workspace:*",
    "@dthcms/shared-schemas": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.19",
    "expo-audio": "57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "nativewind": "^4.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-worklets": "0.12.1",
    "tailwindcss": "^4.3.3",
    "use-intl": "^4.14.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@dthcms/test-config": "workspace:*",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
