# DTHCMS local development configuration (CP04).
#
# Copy to .env and adjust only if a port clashes with something already running:
#
#     cp .env.example .env          # macOS/Linux
#     Copy-Item .env.example .env   # Windows
#
# These credentials are for the local stack only. They are weak on purpose and are
# committed on purpose: this stack must never contain real data. Production secrets
# live in Secret Manager and never in a file.

# --- Postgres ---
POSTGRES_USER=dthcms
POSTGRES_PASSWORD=dthcms_local_only
POSTGRES_DB=dthcms
# 5433 avoids clashing with a PostgreSQL installed natively on the host.
POSTGRES_PORT=5433

# --- Redis ---
# 6380 avoids clashing with Memurai or a Redis service installed on the host.
REDIS_PORT=6380

# --- Object storage (MinIO, standing in for Google Cloud Storage) ---
MINIO_USER=dthcms
MINIO_PASSWORD=dthcms_local_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mock AI and OCR service ---
MOCKAI_PORT=8090

# --- Observability (traces, metrics, dashboards, alerts) ---
# One container: OpenTelemetry Collector, Prometheus, Tempo and Grafana.
OTEL_LGTM_VERSION=0.8.1
# 3001, not Grafana's default 3000 — the Next.js web app takes that.
GRAFANA_PORT=3001
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
# Who receives alert email. Delivered to Mailpit locally, so it is safe and visible.
DTHCMS_ALERT_EMAIL=amlan@dthcms.local

# --- Mail capture ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Application settings (reference) ---
#
# docker compose reads this file; the Go binaries do not. These are listed so the
# defaults are discoverable in one place. Set them in your shell only to override.
#
# DTHCMS_POSTGRES_URL             postgres://dthcms_app_local:dthcms_local_only@127.0.0.1:5433/dthcms?sslmode=disable
# DTHCMS_POSTGRES_MIGRATION_URL   postgres://dthcms:dthcms_local_only@127.0.0.1:5433/dthcms?sslmode=disable
# DTHCMS_TEST_POSTGRES_URL        postgres://dthcms:dthcms_local_only@127.0.0.1:5433/postgres?sslmode=disable
# DTHCMS_OTEL_ENDPOINT            127.0.0.1:4318          (host:port, no scheme)
# DTHCMS_OTEL_ENABLED             true
# DTHCMS_OTEL_SAMPLE_RATIO        1.0                     (every trace, locally)
#
# The application connects as dthcms_app_local, which `make migrate` creates. That role
# may append to the event ledger and may not modify it — the same restriction it has in
# production, so a forbidden write fails here rather than in staging (docs/database.md).
