# DTHCMS local development configuration (CP04).
#
# Copy to .env and adjust only if a port clashes with something already running:
#
#     cp .env.example .env          # macOS/Linux
#     Copy-Item .env.example .env   # Windows
#
# These credentials are for the local stack only. They are weak on purpose and are
# committed on purpose: this stack must never contain real data. Production secrets
# live in Secret Manager and never in a file.

# --- Postgres ---
POSTGRES_USER=dthcms
POSTGRES_PASSWORD=dthcms_local_only
POSTGRES_DB=dthcms
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Object storage (MinIO, standing in for Google Cloud Storage) ---
MINIO_USER=dthcms
MINIO_PASSWORD=dthcms_local_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mock AI and OCR service ---
MOCKAI_PORT=8090

# --- Mail capture ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
