#!/bin/sh
# Conventional Commits check. Installed by scripts/init-repo.ps1 via core.hooksPath.
msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Allow merge, revert and fixup commits through untouched.
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9/._-]+\))?(!)?: .{1,90}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  cat >&2 <<'MSG'

  Commit message rejected — DTHCMS uses Conventional Commits.

  Required:  <type>(<optional scope>): <subject>
  Types:     feat fix docs style refactor perf test build ci chore revert

  Examples:
    feat(cp06/db): add append-only ledger schema
    fix(sync): stop retry loop dropping the last queued event
    docs(adr): record the modular monolith decision

  See CONTRIBUTING.md.

MSG
  exit 1
fi
exit 0
