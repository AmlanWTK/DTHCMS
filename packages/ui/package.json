{
  "name": "@dthcms/ui",
  "version": "0.1.0",
  "private": true,
  "description": "DTHCMS web primitives. Bilingual, accessible, built on the design tokens.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
