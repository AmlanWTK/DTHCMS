          "bmi": 34.2
        },
        "expected": {
          "international": "obese_i",
          "asian": "obese_ii"
        }
      },
      {
        "name": "BMI 41.0 is obese III internationally; the Asian scale defines no such band",
        "inputs": {
          "bmi": 41.0
        },
        "expected": {
          "international": "obese_iii",
          "asian": "obese_ii"
