{
  "name": "@dthcms/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client generated from api/openapi.yaml — the one API surface for web and mobile",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../api/openapi.yaml --output src/schema.ts && prettier --write src/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dthcms/shared-schemas": "workspace:*",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@dthcms/test-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
