{
  "name": "@dthcms/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "One token source for DTHCMS: web CSS variables, NativeWind theme, print styles",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css": "./dist/tokens.css",
    "./print": "./dist/tokens.print.css",
    "./tailwind": "./dist/tailwind-theme.js",
    "./nativewind": "./dist/nativewind-theme.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsx src/build.cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@dthcms/test-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
