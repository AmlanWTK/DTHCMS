{
  "name": "dthcms",
  "private": true,
  "version": "0.1.0",
  "description": "DTHCMS — Digital Diabetes, Thyroid & Hormone Clinic Management System",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "pnpm --filter @dthcms/design-tokens build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run spec:lint && pnpm run typecheck && pnpm run test:coverage",
    "spec:lint": "redocly lint",
    "spec:docs": "node scripts/build-api-docs.mjs",
    "api:generate": "pnpm --filter @dthcms/api-client run generate",
    "test:coverage": "pnpm -r --if-present test:coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.49.0",
    "eslint": "^10.9.1",
    "prettier": "^3.4.2",
    "redoc": "^2.5.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
